{
  "manifest_version": 3,
  "name": "Study Buddy",
  "version": "0.1",
  "description": "A buddy on your screen that keeps you focused.",
  "permissions": ["storage", "tabs", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "run_at": "document_idle" }
  ]
}
